{
  "schemaVersion": 1,
  "id": "access-control-checks-v1",
  "requirementVersion": "v1",
  "checks": [
    {
      "name": "active authenticated same tenant",
      "input": {
        "actor": {
          "id": "alice",
          "tenantId": "acme",
          "authenticated": true,
          "active": true
        },
        "document": {
          "id": "doc-1",
          "tenantId": "acme"
        },
        "membership": {
          "actorId": "alice",
          "tenantId": "acme",
          "active": true
        }
      },
      "expected": true
    },
    {
      "name": "anonymous actor",
      "input": {
        "actor": {
          "id": "alice",
          "tenantId": "acme",
          "authenticated": false,
          "active": true
        },
        "document": {
          "id": "doc-1",
          "tenantId": "acme"
        },
        "membership": {
          "actorId": "alice",
          "tenantId": "acme",
          "active": true
        }
      },
      "expected": false
    },
    {
      "name": "inactive actor",
      "input": {
        "actor": {
          "id": "alice",
          "tenantId": "acme",
          "authenticated": true,
          "active": false
        },
        "document": {
          "id": "doc-1",
          "tenantId": "acme"
        },
        "membership": {
          "actorId": "alice",
          "tenantId": "acme",
          "active": true
        }
      },
      "expected": false
    },
    {
      "name": "cross tenant actor",
      "input": {
        "actor": {
          "id": "alice",
          "tenantId": "other",
          "authenticated": true,
          "active": true
        },
        "document": {
          "id": "doc-1",
          "tenantId": "acme"
        },
        "membership": {
          "actorId": "alice",
          "tenantId": "acme",
          "active": true
        }
      },
      "expected": false
    },
    {
      "name": "missing actor",
      "input": {
        "actor": null,
        "document": {
          "id": "doc-1",
          "tenantId": "acme"
        },
        "membership": {
          "actorId": "alice",
          "tenantId": "acme",
          "active": true
        }
      },
      "expected": false
    },
    {
      "name": "missing document",
      "input": {
        "actor": {
          "id": "alice",
          "tenantId": "acme",
          "authenticated": true,
          "active": true
        },
        "document": null,
        "membership": {
          "actorId": "alice",
          "tenantId": "acme",
          "active": true
        }
      },
      "expected": false
    },
    {
      "name": "missing authentication flag",
      "input": {
        "actor": {
          "id": "alice",
          "tenantId": "acme",
          "active": true
        },
        "document": {
          "id": "doc-1",
          "tenantId": "acme"
        },
        "membership": {
          "actorId": "alice",
          "tenantId": "acme",
          "active": true
        }
      },
      "expected": false
    },
    {
      "name": "truthy string is not authentication",
      "input": {
        "actor": {
          "id": "alice",
          "tenantId": "acme",
          "authenticated": "true",
          "active": true
        },
        "document": {
          "id": "doc-1",
          "tenantId": "acme"
        },
        "membership": {
          "actorId": "alice",
          "tenantId": "acme",
          "active": true
        }
      },
      "expected": false
    },
    {
      "name": "missing tenant does not match missing tenant",
      "input": {
        "actor": {
          "id": "alice",
          "authenticated": true,
          "active": true
        },
        "document": {
          "id": "doc-1"
        },
        "membership": {
          "actorId": "alice",
          "tenantId": "acme",
          "active": true
        }
      },
      "expected": false
    },
    {
      "name": "v1 membership is irrelevant",
      "input": {
        "actor": {
          "id": "alice",
          "tenantId": "acme",
          "authenticated": true,
          "active": true
        },
        "document": {
          "id": "doc-1",
          "tenantId": "acme"
        },
        "membership": null
      },
      "expected": true
    },
    {
      "name": "v1 revoked membership is irrelevant",
      "input": {
        "actor": {
          "id": "alice",
          "tenantId": "acme",
          "authenticated": true,
          "active": true
        },
        "document": {
          "id": "doc-1",
          "tenantId": "acme"
        },
        "membership": {
          "actorId": "alice",
          "tenantId": "acme",
          "active": false
        }
      },
      "expected": true
    }
  ]
}
