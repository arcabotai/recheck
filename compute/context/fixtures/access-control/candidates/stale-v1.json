{
  "format": "recheck-policy-v1",
  "expression": {
    "op": "all",
    "args": [
      {
        "op": "truthy",
        "value": {
          "field": "actor.authenticated"
        }
      },
      {
        "op": "truthy",
        "value": {
          "field": "actor.active"
        }
      },
      {
        "op": "eq",
        "left": {
          "field": "actor.tenantId"
        },
        "right": {
          "field": "document.tenantId"
        }
      }
    ]
  }
}
